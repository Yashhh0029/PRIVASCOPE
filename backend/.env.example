# PRIVASCOPE Backend Environment Configuration Template
# Copy this file to .env and supply your environment-specific values.
# NEVER commit actual .env files containing production secrets to version control.

# Application Environment (development | production)
ENV=development

# Database Configuration
# Local Development: sqlite:///./privascope.db
# Production: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./privascope.db

# Security & JWT Session
# In production, JWT_SECRET must be at least 32 characters generated cryptographically (e.g., openssl rand -hex 32)
JWT_SECRET=privascope-dev-only-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Authorized CORS Origins (Comma-separated list of allowed frontend origins)
# Production Example: https://privascope.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 / OpenID Connect
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# AI Privacy Firewall & Gateway (Mode B)
# Providers: local_demo (default air-gapped demo provider), openai, anthropic, gemini
DEFAULT_GATEWAY_PROVIDER=local_demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GATEWAY_SESSION_TTL_MINUTES=30

# File Upload Policies
MAX_UPLOAD_SIZE_MB=25
TEMP_FILE_RETENTION_HOURS=24
