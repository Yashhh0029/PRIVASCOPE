# PRIVASCOPE Frontend Environment Configuration Template
# Copy this file to .env and supply your environment-specific values.

# Backend API base URL
# Local Development: http://localhost:8000/api
# Production Example: https://api.privascope.example.com/api
VITE_API_URL=http://localhost:8000/api

# Google OAuth 2.0 Web Application Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Ensure the authorized JavaScript origin matches the deployed frontend domain (e.g., https://privascope.example.com)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
