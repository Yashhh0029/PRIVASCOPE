# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Build & Distribution
build/
dist/
*.egg-info/
frontend/dist/
frontend/dist-ssr/

# Node.js
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Cache
.pytest_cache/
.coverage
coverage/
htmlcov/

# Databases
*.db
*.sqlite
*.sqlite3

# Storage & Uploads (Preserve directory structure via .gitkeep)
uploads/
storage/
logs/
*.log
backend/app/storage/uploads/*
!backend/app/storage/uploads/.gitkeep
backend/app/storage/protected/*
!backend/app/storage/protected/.gitkeep
backend/app/storage/temp/*
!backend/app/storage/temp/.gitkeep

# Secrets & Environment Variables (Never commit real .env files)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key

# Operating System & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
